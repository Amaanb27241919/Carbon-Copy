FROM node:22-alpine

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json* ./
RUN npm ci --production

# Copy core services + entry point
COPY api-server-v2.js ./
COPY dashboard-v2.js ./
COPY schema-v2.sql ./
COPY core/ ./core/

EXPOSE 3001

ENV NODE_ENV=production

CMD ["node", "api-server-v2.js"]
