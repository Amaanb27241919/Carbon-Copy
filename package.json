{
  "name": "carbon-core",
  "version": "3.0.0",
  "description": "Carbon Core — secure self-hosted AI project build and deployment platform",
  "main": "api-server-v2.js",
  "scripts": {
    "start": "node api-server-v2.js",
    "dev": "node --watch api-server-v2.js",
    "test": "node --test",
    "migrate": "node -e \"import('./core/db-adapter.js').then(m => m.initDb().then(db => m.migrateV2Schema(db)).then(() => process.exit(0)))\""
  },
  "dependencies": {
    "better-sqlite3": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
