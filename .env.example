# Secrets — replace ALL values before use
JWT_SECRET=change-me-64-char-random-hex-secret-do-not-use-in-production
JWT_REFRESH_SECRET=change-me-another-64-char-random-hex-secret-different-from-above

INTERNAL_SERVICE_TOKEN=change-me-internal-service-token-secret

POSTGRES_USER=carbon
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=carbon_db

REDIS_PASSWORD=change-me-redis-password

MINIO_ACCESS_KEY=carbonminio
MINIO_SECRET_KEY=change-me-minio-secret

GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana-password

# LLM Configuration (OpenAI-compatible — works with OpenAI, Ollama, etc.)
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
OPENCLAW_LLM_MODEL=gpt-4o
NEMOCLAW_LLM_MODEL=gpt-4o-mini
NEMOCLAW_EMBEDDING_MODEL=text-embedding-3-small

# Sandbox & Dev Environment
CODE_SERVER_PASSWORD=change-me-vscode-password
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_MB=2048
SANDBOX_TIMEOUT_MINUTES=30

# Model Router — AI Provider Configuration
# Set DEFAULT_PROVIDER to: ollama | openai | claude | huggingface
DEFAULT_PROVIDER=ollama

# Ollama (local models — no API key needed)
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_PRELOAD_MODELS=llama3.2

# OpenAI (optional — leave blank to disable)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic/Claude (optional — leave blank to disable)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# HuggingFace (optional — leave blank to use HF open models without auth)
HF_API_KEY=
HF_DEFAULT_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── QEMU/KVM Virtual Machines ─────────────────────────────────────────────
# Your server's LAN IP — used to build SSH connection strings
HOST_IP=192.168.1.100
# Max simultaneous VMs (each uses SSH port 2200+N, VNC port 5900+N)
VM_MAX_COUNT=10

# ── Homelab + Storage ──────────────────────────────────────────────────────

# Timezone (for Pi-hole, Syncthing, DuckDNS)
TZ=America/New_York

# Tailscale VPN — get a key at https://login.tailscale.com/admin/settings/keys
# Leave blank to skip Tailscale
TAILSCALE_AUTH_KEY=
TAILSCALE_HOSTNAME=carbon-copy

# DuckDNS — free dynamic DNS at https://www.duckdns.org
# Leave blank to skip dynamic DNS
DUCKDNS_SUBDOMAIN=your-subdomain
DUCKDNS_TOKEN=

# Pi-hole DNS admin password
PIHOLE_PASSWORD=change-me-pihole-password

# Samba file share password
SAMBA_PASSWORD=change-me-samba-password
