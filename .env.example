# Secrets — replace ALL values before use
JWT_SECRET=change-me-64-char-random-hex-secret-do-not-use-in-production
JWT_REFRESH_SECRET=change-me-another-64-char-random-hex-secret-different-from-above

INTERNAL_SERVICE_TOKEN=change-me-internal-service-token-secret

POSTGRES_USER=carbon
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=carbon_db

REDIS_PASSWORD=change-me-redis-password

MINIO_ACCESS_KEY=carbonminio
MINIO_SECRET_KEY=change-me-minio-secret

GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana-password

# LLM Configuration (OpenAI-compatible — works with OpenAI, Ollama, etc.)
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
OPENCLAW_LLM_MODEL=gpt-4o
NEMOCLAW_LLM_MODEL=gpt-4o-mini
NEMOCLAW_EMBEDDING_MODEL=text-embedding-3-small
